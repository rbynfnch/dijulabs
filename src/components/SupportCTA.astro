---
import { Image } from 'astro:assets';
import workshop from '../assets/workshop.webp';
import { SITE } from '../data/site';
---
<section class="support wrap reveal" aria-labelledby="support-h">
  <div class="support-card">
    <!-- The photo's white fade is blended into the cream card (mix-blend-mode: multiply), so it always matches the background -->
    <Image
      class="support-photo"
      src={workshop}
      alt={`${SITE.maker} at a desk in the DIJULABS workshop`}
      widths={[640, 960, 1280]}
      sizes="(min-width: 768px) 800px, 100vw"
      loading="lazy"
    />
    <div class="support-body">
      <p class="eyebrow">SUPPORT</p>
      <h2 id="support-h">Like what I'm building?</h2>
      <p>DIJULABS is a small workshop for ideas, experiments, and apps. If something I've built is useful to you, you can help me keep building.</p>
      <a class="btn btn-dark" href={SITE.supportUrl} rel="noopener" target="_blank">
        <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.7 4.5 6.4 4.5c2.1 0 3.6 1.2 4.6 2.6l1 1.4 1-1.4c1-1.4 2.5-2.6 4.6-2.6 3.7 0 5.5 3.9 4 7.3C19.5 16.4 12 21 12 21z"/></svg>
        SUPPORT DIJULABS
      </a>
    </div>
  </div>
</section>
